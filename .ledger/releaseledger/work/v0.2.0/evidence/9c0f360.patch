-def _safe_bundle_path(value: Any) -> str | None:
-    if not isinstance(value, str) or not value or "\\" in value or value.startswith("/"):
-        return None
-    path = PurePosixPath(value)
-    if path.as_posix() != value or any(part in {".", ".."} for part in path.parts):
